<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/weather_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/weather_widget_black" android:padding="14dp">
 <TextView android:id="@+id/weather_widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="TWO THUMBS INCORPORATED™" android:textColor="#D9B85F" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:paddingBottom="8dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
  <LinearLayout android:id="@+id/weather_widget_calendar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="2dp">
   <TextView android:id="@+id/weather_widget_month" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#D6D4D7" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
   <TextView android:id="@+id/weather_widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFFFFF" android:textSize="58sp" android:fontFamily="sans-serif-light" android:includeFontPadding="false"/>
   <TextView android:id="@+id/weather_widget_weekday" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#BEBBC2" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/weather_widget_forecast" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="2dp">
   <ImageView android:id="@+id/weather_widget_icon" android:layout_width="40dp" android:layout_height="32dp" android:importantForAccessibility="no"/>
   <TextView android:id="@+id/weather_widget_temperature" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFFFFF" android:textSize="33sp" android:fontFamily="sans-serif-light" android:includeFontPadding="false"/>
   <TextView android:id="@+id/weather_widget_condition" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#D6D4D7" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
   <TextView android:id="@+id/weather_widget_place" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#AAA6AF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:paddingTop="3dp"/>
   <TextView android:id="@+id/weather_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#777381" android:textSize="8sp" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp"/>
  </LinearLayout>
 </LinearLayout>
</LinearLayout>
